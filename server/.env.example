# Copy to .env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=5000

# Local MongoDB:   mongodb://127.0.0.1:27017/spms
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spms

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run seed:admin`
SEED_ADMIN_NAME=TPO Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@12345
